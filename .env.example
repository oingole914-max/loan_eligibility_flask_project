# ---------------------------------------------------------------------
# Loan Eligibility Prediction System — environment template
# Copy this file to .env and replace every placeholder value.
# Never commit .env to version control.
# ---------------------------------------------------------------------

# Flask
FLASK_APP=app.py
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-secret
HOST=127.0.0.1
PORT=5000

# Database
# Default when DATABASE_URL is omitted:
#   SQLite at instance/loan_eligibility.db
# MySQL example (PyMySQL driver):
# DATABASE_URL=mysql+pymysql://loan_user:CHANGE_ME@127.0.0.1:3306/loan_eligibility?charset=utf8mb4
# SQLite example:
# DATABASE_URL=sqlite:///instance/loan_eligibility.db
AUTO_CREATE_DB=1

# Model files (relative paths resolve from the project root)
MODEL_PATH=loan_model.pkl
METRICS_PATH=model_metrics.json

# Session cookie security. Set to 1 only when serving over HTTPS.
SESSION_COOKIE_SECURE=0

# Administrator bootstrap values used by:
#   flask --app app create-admin
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
